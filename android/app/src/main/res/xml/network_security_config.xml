<?xml version="1.0" encoding="utf-8"?>
<!--
    Production (release) network policy: HTTPS only, no cleartext, anywhere.

    Local-dev cleartext exceptions (10.0.2.2 / localhost / LAN IP) live in
    src/debug/res/xml/network_security_config.xml and apply to DEBUG builds only.
    Because that file overrides this one only for the debug source set, a RELEASE
    build physically cannot talk plain http — there is no way to ship cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
