# Copy this file to `keystore.properties` (which is gitignored) and fill it in.
# app/build.gradle.kts reads it to sign the release build. With no keystore.properties
# present, debug builds still work and release assemble/bundle tasks stop with an error.
# Release builds separately require MONEYMINDER_SERVER_URL via a Gradle -P property
# or environment variable; it does not belong in this signing-secrets file.
#
# 1) Create your upload keystore once (keep it forever; losing it blocks updates):
#
#      keytool -genkeypair -v \
#        -keystore moneyminder-release.jks \
#        -alias moneyminder \
#        -keyalg RSA -keysize 2048 -validity 10000
#
#    Run it from the android/ folder so the relative storeFile path below resolves.
#
# 2) Fill in the values below. NEVER commit the .jks file or the real passwords.

storeFile=moneyminder-release.jks
storePassword=CHANGE_ME
keyAlias=moneyminder
keyPassword=CHANGE_ME
