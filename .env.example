# Production mode enables secure cookies and fail-fast configuration checks.
# NODE_ENV=production

# Required when NODE_ENV=production; must be at least 32 bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Required when NODE_ENV=production. Exact public HTTPS origin, no path.
# APP_ORIGIN=https://moneyminder.example.com

# Bind only to host loopback in production. A same-host HTTPS reverse proxy is
# the only supported public entry point.
# LISTEN_HOST=127.0.0.1

# Production registration is closed by default. Open it only for controlled
# enrollment, then close it again.
# REGISTRATION_ENABLED=false

# Merchant promotions are disabled by default. Do not enable them until the
# merchant and public HTTPS destination are verified, metric retention is
# finite/enforced, privacy/data-safety disclosures are reconciled, and Google
# Play shows the correct "Contains ads" declaration.
# PROMOTIONS_ENABLED=false

# Proxy trust boundary. Production requires loopback behind a same-host TLS
# reverse proxy; this Node process does not terminate TLS. Development defaults
# to 0. Numeric hop counts are rejected because direct clients could forge
# forwarding headers.
# TRUST_PROXY=loopback

# One absolute durable root for SQLite and receipt uploads. Defaults to ./data
# in development. Do not point production at ephemeral storage.
# DATA_DIR=/absolute/persistent/path

# SQLite is auto-created and migrated at startup. It defaults to
# DATA_DIR/moneyminder.sqlite3. When set in production, this must be an absolute
# path inside DATA_DIR.
# SQLITE_FILE=/absolute/persistent/path/moneyminder.sqlite3
#
# Do not set legacy PostgreSQL or JSON-store variables. DATABASE_URL,
# DATABASE_POOL_MAX, PG_POOL_MAX, and DATA_FILE are rejected at startup.

# Positive integer ceiling for application state JSON, in bytes. Defaults to 25 MiB.
# Growing writes above it return HTTP 507; shrinking/deletion remains allowed.
# DATA_MAX_BYTES=26214400

# Global receipt-upload ceilings across all accounts. Defaults: 4 GiB and
# 10,000 files. New uploads return HTTP 507 when either ceiling is reached.
# UPLOAD_TOTAL_MAX_BYTES=4294967296
# UPLOAD_TOTAL_MAX_FILES=10000

# IANA time zone used for budget months, daily trends, and recurring bills.
# APP_TIME_ZONE=Asia/Kolkata

# Exact Chrome extension origin allowed in production. Omit to disable extension
# CORS. Obtain the 32-character ID from the installed release; do not guess it.
# Format: EXTENSION_ORIGIN=chrome-extension://<installed-release-id>

# Port to listen on (optional, defaults to 3000)
# PORT=3000

# Receipt OCR is local: images stay on this server and the checksum-verified
# English model is bundled in the image.
