# Install as /etc/moneyminder/app.env, replace every <...> value, and set
# root:root ownership with mode 0600. This template is for a maximum pilot
# cohort of 30 active accounts; it is not a multi-instance configuration.
NODE_ENV=production
PORT=3000
LISTEN_HOST=127.0.0.1
APP_ORIGIN=https://<CONTROLLED_APP_HOST>
SESSION_SECRET=<AT_LEAST_32_RANDOM_BYTES>
DATA_DIR=/var/lib/moneyminder
SQLITE_FILE=/var/lib/moneyminder/moneyminder.sqlite3
APP_TIME_ZONE=Asia/Kolkata
TRUST_PROXY=loopback
REGISTRATION_ENABLED=false
# Leave false unless the merchant, public HTTPS destination, metric-retention,
# privacy, Data safety, Play Ads, security, and accessibility gates are complete.
PROMOTIONS_ENABLED=false
DATA_MAX_BYTES=26214400
UPLOAD_TOTAL_MAX_BYTES=4294967296
UPLOAD_TOTAL_MAX_FILES=10000

# Add only after the Chrome Web Store has assigned the stable 32-character ID.
# EXTENSION_ORIGIN=chrome-extension://<CHROME_WEB_STORE_ITEM_ID>
